# Default configuration — checked into git.
# To customise locally: create config.local next to this file (git-ignored)
# and set only the values you want to override.
# Real environment variables always take precedence over both files.

# HTTP port the backend listens on
PORT=8080

# SQLite database file path (relative to backend/)
DB_PATH=./connections.db

# Wrong guesses allowed per game (1–10)
MAX_MISTAKES=4

# Puzzle source — GitHub archive or a local JSON file
# Local file example: DATA_URL=../assets/custom_games.json
DATA_URL=https://raw.githubusercontent.com/Eyefyre/NYT-Connections-Answers/main/connections.json

# LM Studio base URL (no /v1 suffix) — used by suggest_groups and the health check
EMBED_URL=http://localhost:1234

# Embedding model name — leave empty to auto-discover from /v1/models
EMBED_MODEL=

# API key for the embedding server — leave empty for local LM Studio
EMBED_KEY=

# ── Solver (cmd/solve) ──────────────────────────────────────────────────────

# Directory containing the 9 stage prompt files (relative to backend/)
PROMPT_DIR=../PROMPT/AGGRESIVE
#PROMPT_DIR=../PROMPT/TIMID

# How long a single model call may run before the watchdog interrupts it
# Accepts Go duration strings: 3m, 90s, 1m30s, etc.
WATCHDOG_TIMEOUT=5m

# Approximate token budget per model call (chars/4); watchdog fires when exceeded
WATCHDOG_TOKENS=4000
